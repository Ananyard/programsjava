class MovieSelection {
    public static void selectMovie(String movie, String time, String seatType, int price) {
        System.out.println("Movie Selected: " + movie);
        System.out.println("Showtime: " + time);
        System.out.println("Seat Type: " + seatType);
        
        SeatAvailability.checkSeats(movie, time, seatType, price);
    }
}
